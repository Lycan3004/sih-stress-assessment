generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Represents a victim, user, or responder in our system
model User {
  id          String       @id @default(uuid())
  firebaseUid String       @unique
  email       String       @unique
  name        String?
  role        String       @default("VICTIM")
  assessments Assessment[]
  createdAt   DateTime     @default(now())
}

// Represents a single trauma/stress assessment session
model Assessment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  textInput String?
  audioUrl  String?
  sviScore  Float?
  riskLevel String   @default("PENDING")
  createdAt DateTime @default(now())
}

